
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Global identity validation.
    // Legacy accounts may not have a global identity yet.

    function hasValidGlobalAccount() {
      let path = /databases/$(database)/documents/accountIdentities/$(request.auth.uid);

      return !exists(path) || (
        get(path).data.get('uid', '') == request.auth.uid
        && get(path).data.get('schemaVersion', 0) == 1
        && get(path).data.get('status', '') == 'active'
      );
    }

    function hasActiveLegacyStatus() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);

      return !exists(path) || (
        get(path).data.get('uid', request.auth.uid) == request.auth.uid
        && get(path).data.get('status', 'active') == 'active'
      );
    }

    function isAccountActive() {
      return isSignedIn()
        && hasValidGlobalAccount()
        && hasActiveLegacyStatus();
    }

    function hasStartupProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);

      return exists(path)
        && (
          get(path).data.get(
            'roles',
            [get(path).data.get('role', '')]
          ) is list
        )
        && get(path).data.get(
          'roles',
          [get(path).data.get('role', '')]
        ).hasAny(['founder', 'investor', 'mentor']);
    }

    function hasStartupAccess() {
      return isAccountActive()
        && hasStartupProfile();
    }

    function isHardcodedAdmin() {
      return isAccountActive() && (
        request.auth.uid == 'T2JnkPYdsoZGO8krUqcP3T5bvg62' ||
        (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') == 'shahmubaruk05@gmail.com')
      );
    }

    function isAdmin() {
      return isHardcodedAdmin() || (
        isAccountActive() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['admin', 'super_admin'])
        )
      );
    }

    function isOwner(userId) {
      return hasStartupAccess() && request.auth.uid == userId;
    }

    function isDealParticipant(dealId) {
      let deal = get(/databases/$(database)/documents/dealRooms/$(dealId)).data;
      return hasStartupAccess() && (deal.founderUid == request.auth.uid || deal.investorUid == request.auth.uid);
    }

    // --- Collection Rules ---

    // Public professional profiles.
    // Writes are managed by trusted server-side code.
    match /publicProfiles/{userId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /signupRateLimits/{key} {
      allow read, write: if false;
    }

    // Global Account Identity.
    // Trusted server-side access only.
    match /accountIdentities/{userId} {
      allow read, write: if false;
    }

    // Event Organizer profiles.
    // Access is managed by trusted server-side APIs.

    match /eventOrganizerProfiles/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if false;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'plan',
            'subscriptionStatus',
            'bonusLimits',
            'referralCount',
            'updatedAt'
          ]);
    }

    match /dealRooms/{dealId} {
      allow get: if isHardcodedAdmin()
        || (hasStartupAccess() && resource != null && (
          resource.data.get('founderUid', '') == request.auth.uid
          || resource.data.get('investorUid', '') == request.auth.uid
        ))
        || (hasStartupAccess()
          && !exists(/databases/$(database)/documents/dealRooms/$(dealId))
          && dealId.matches('^funding_' + request.auth.uid + '_[^/]+$'));

      allow list: if isHardcodedAdmin()
        || (hasStartupAccess() && (
          resource.data.get('founderUid', '') == request.auth.uid
          || resource.data.get('investorUid', '') == request.auth.uid
        ));

      allow create: if hasStartupAccess()
        && request.resource.data.keys().hasOnly([
          'startupId', 'founderUid', 'investorUid',
          'connectionId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'startupId', 'founderUid', 'investorUid',
          'connectionId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.founderUid == request.auth.uid
        && request.resource.data.startupId == request.auth.uid
        && request.resource.data.investorUid is string
        && request.resource.data.connectionId is string
        && dealId == 'funding_' + request.auth.uid + '_' + request.resource.data.investorUid
        && request.resource.data.status == 'Discovery'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId))
        && getAfter(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.type == 'investor'
        && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.recipientUid == request.auth.uid
        && get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.initiatorUid == request.resource.data.investorUid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && (
          resource.data.founderUid == request.auth.uid ||
          resource.data.investorUid == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in [
          'Discovery',
          'Due Diligence',
          'Negotiation',
          'Committed',
          'Closed',
          'Cancelled'
        ]
        && request.resource.data.updatedAt == request.time
      );

      match /notes/{noteId} { allow read, write: if isDealParticipant(dealId); }
      match /documents/{docId} { allow read, write: if isDealParticipant(dealId); }
      match /checklist/{itemId} { allow read, write: if isDealParticipant(dealId); }
      match /timeline/{evtId} {
        allow read: if isDealParticipant(dealId);
        allow update, delete: if evtId != "deal_init"
          && isDealParticipant(dealId);

        allow create: if (evtId != 'deal_init' && isDealParticipant(dealId)) || (
          hasStartupAccess()
          && evtId == 'deal_init'
          && request.resource.data.keys().hasOnly([
            'type', 'details', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'details', 'createdAt'
          ])
          && request.resource.data.type == 'deal_init'
          && request.resource.data.details == 'Investment Deal Room initialized.'
          && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/dealRooms/$(dealId))
          && getAfter(/databases/$(database)/documents/dealRooms/$(dealId)).data.founderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/dealRooms/$(dealId)).data.startupId == request.auth.uid
          && dealId == 'funding_' + request.auth.uid + '_' +
            getAfter(/databases/$(database)/documents/dealRooms/$(dealId)).data.investorUid
        );
      }
    }

    match /mentorshipRequests/{requestId} {
      allow get, list: if isHardcodedAdmin() ||
        (hasStartupAccess() && (
          resource.data.get('founderUid', '') == request.auth.uid ||
          resource.data.get('mentorUid', '') == request.auth.uid
        ));

      allow create: if hasStartupAccess()
        && request.resource.data.keys().hasAll([
          'mentorUid', 'founderUid', 'startupId',
          'subject', 'message', 'goals',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'mentorUid', 'founderUid', 'startupId',
          'subject', 'message', 'goals',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.founderUid == request.auth.uid
        && request.resource.data.mentorUid is string
        && request.resource.data.mentorUid != request.auth.uid
        && request.resource.data.status == 'Pending';

      allow update: if hasStartupAccess()
        && resource.data.status == 'Pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (
            resource.data.founderUid == request.auth.uid
            && request.resource.data.status == 'Cancelled'
          )
          ||
          (
            resource.data.mentorUid == request.auth.uid
            && request.resource.data.status == 'Declined'
          )
          ||
          (
            resource.data.mentorUid == request.auth.uid
            && request.resource.data.status == 'Accepted'
            && getAfter(
              /databases/$(database)/documents/activeMentorships/$(('mentorship_' + requestId))
            ).data.requestId == requestId
          )
        );

      allow delete: if isAdmin();
    }

    match /activeMentorships/{mentorshipId} {
      allow read: if isHardcodedAdmin() || (hasStartupAccess() && (resource.data.get('mentorUid', '') == request.auth.uid || resource.data.get('founderUid', '') == request.auth.uid));
      allow create: if hasStartupAccess()
        && mentorshipId == "mentorship_" + request.resource.data.requestId
        && request.resource.data.mentorUid == request.auth.uid
        && request.resource.data.status == "Onboarding"
        && get(
          /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)
        ).data.status == "Pending"
        && getAfter(
          /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)
        ).data.status == "Accepted"
        && getAfter(
          /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)
        ).data.mentorUid == request.resource.data.mentorUid
        && getAfter(
          /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)
        ).data.founderUid == request.resource.data.founderUid
        && getAfter(
          /databases/$(database)/documents/mentorshipRequests/$(request.resource.data.requestId)
        ).data.startupId == request.resource.data.startupId;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.mentorUid == request.auth.uid
        && request.resource.data.status in [
          "Onboarding", "Discovery", "Growth Planning",
          "Execution", "Completed"
        ]
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["status", "lastActivityAt"])
      );
      
      match /notes/{noteId} {
        allow read: if isHardcodedAdmin() || (hasStartupAccess() && (
          (resource.data.type == 'shared' && (get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid || get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.founderUid == request.auth.uid)) ||
          (resource.data.type == 'private' && get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid)
        ));
        allow create: if hasStartupAccess() && (
          (request.resource.data.type == 'shared' && (get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid || get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.founderUid == request.auth.uid)) ||
          (request.resource.data.type == 'private' && get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid)
        );
      }
      
      match /timeline/{itemId} {
        allow create: if hasStartupAccess()
          && itemId == "initial_start"
          && mentorshipId.matches("^mentorship_[^/]+$")
          && !exists(/databases/$(database)/documents/activeMentorships/$(mentorshipId))
          && getAfter(
            /databases/$(database)/documents/activeMentorships/$(mentorshipId)
          ).data.mentorUid == request.auth.uid
          && mentorshipId == "mentorship_" + getAfter(
            /databases/$(database)/documents/activeMentorships/$(mentorshipId)
          ).data.requestId
          && get(
            /databases/$(database)/documents/mentorshipRequests/$(getAfter(
              /databases/$(database)/documents/activeMentorships/$(mentorshipId)
            ).data.requestId)
          ).data.status == "Pending"
          && request.resource.data.type == "start"
          && request.resource.data.details == "Mentorship relationship established.";
        allow read: if hasStartupAccess() && (get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid || get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.founderUid == request.auth.uid);
        allow create: if hasStartupAccess()
          && itemId != "initial_start"
          && request.resource.data.keys().hasOnly(["type", "details", "createdAt"])
          && request.resource.data.keys().hasAll(["type", "details", "createdAt"])
          && request.resource.data.createdAt == request.time
          && (
            (
              request.resource.data.type == "note"
              && (
                (
                  get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid
                  && request.resource.data.details == "Mentor added a shared note."
                )
                ||
                (
                  get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.founderUid == request.auth.uid
                  && request.resource.data.details == "Founder added a shared note."
                )
              )
            )
            ||
            (
              request.resource.data.type == "status_change"
              && get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.mentorUid == request.auth.uid
              && get(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.status != getAfter(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.status
              && getAfter(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.status in [
                "Onboarding", "Discovery", "Growth Planning",
                "Execution", "Completed"
              ]
              && request.resource.data.details ==
                "Mentorship progress updated to " + getAfter(/databases/$(database)/documents/activeMentorships/$(mentorshipId)).data.status + "."
            )
          );
      }
    }

    match /mentorshipSessions/{sessionId} {
      allow read: if isHardcodedAdmin() || (hasStartupAccess() && (resource.data.get('mentorUid', '') == request.auth.uid || resource.data.get('founderUid', '') == request.auth.uid));
      allow create: if hasStartupAccess()
        && request.resource.data.keys().hasAll([
          "mentorshipId", "mentorUid", "founderUid", "startupId",
          "title", "agenda", "scheduledAt", "estimatedDuration",
          "meetingType", "meetingLink", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "mentorshipId", "mentorUid", "founderUid", "startupId",
          "title", "agenda", "scheduledAt", "estimatedDuration",
          "meetingType", "meetingLink", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.mentorshipId is string
        && exists(/databases/$(database)/documents/activeMentorships/$(request.resource.data.mentorshipId))
        && get(/databases/$(database)/documents/activeMentorships/$(request.resource.data.mentorshipId)).data.mentorUid == request.auth.uid
        && request.resource.data.mentorUid == get(/databases/$(database)/documents/activeMentorships/$(request.resource.data.mentorshipId)).data.mentorUid
        && request.resource.data.founderUid == get(/databases/$(database)/documents/activeMentorships/$(request.resource.data.mentorshipId)).data.founderUid
        && request.resource.data.startupId == get(/databases/$(database)/documents/activeMentorships/$(request.resource.data.mentorshipId)).data.startupId
        && request.resource.data.status == "Scheduled"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasStartupAccess()
        && resource.data.mentorUid == request.auth.uid
        && resource.data.status == "Scheduled"
        && request.resource.data.status == "Completed"
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "summary", "keyLearnings", "nextSteps",
            "status", "completedAt", "updatedAt"
          ])
        && request.resource.data.keys().hasAll([
          "summary", "keyLearnings", "nextSteps",
          "completedAt", "updatedAt"
        ])
        && request.resource.data.completedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if isHardcodedAdmin() || (hasStartupAccess() && resource.data.mentorUid == request.auth.uid);

      match /actionItems/{itemId} {
        allow read: if hasStartupAccess() && (get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.mentorUid == request.auth.uid || get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.founderUid == request.auth.uid);
        allow create: if hasStartupAccess()
          && (
            get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.mentorUid == request.auth.uid ||
            get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.founderUid == request.auth.uid
          )
          && request.resource.data.keys().hasAll(["title", "status", "authorUid", "createdAt"])
          && request.resource.data.keys().hasOnly(["title", "status", "authorUid", "createdAt"])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500
          && request.resource.data.status == "Pending"
          && request.resource.data.createdAt == request.time;
        allow update: if hasStartupAccess()
          && (
            get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.mentorUid == request.auth.uid ||
            get(/databases/$(database)/documents/mentorshipSessions/$(sessionId)).data.founderUid == request.auth.uid
          )
          && resource.data.status in ["Pending", "Completed"]
          && request.resource.data.status in ["Pending", "Completed"]
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["status"]);
        allow delete: if false;
      }
    }

    match /savedStartups/{saveId} {
      allow read: if isHardcodedAdmin();
      allow list: if hasStartupAccess() && resource.data.get('investorUid', '') == request.auth.uid;
      allow get: if hasStartupAccess() && resource.data.get('investorUid', '') == request.auth.uid;
      allow create: if hasStartupAccess() && request.resource.data.investorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (hasStartupAccess() && resource.data.investorUid == request.auth.uid);
    }

    match /referralCodes/{code} {
      allow get: if hasStartupAccess();
      allow list: if false;

      allow create: if false;

      allow update, delete: if false;
    }

    match /referrals/{referralId} {
      allow get: if isHardcodedAdmin() || (
        hasStartupAccess()
        && (
          resource.data.get('referrerUid', '') == request.auth.uid
          || resource.data.get('referredUid', '') == request.auth.uid
        )
      );
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && (resource.data.get('referrerUid', '') == request.auth.uid || resource.data.get('referredUid', '') == request.auth.uid));
      allow create: if false;

      allow update: if isAdmin();
    }

    match /venturePitches/{pitchId} {
      allow get: if isAdmin() || (
        hasStartupAccess() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        )
      );
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && (resource.data.get('senderUid', '') == request.auth.uid || resource.data.get('recipientUid', '') == request.auth.uid));
      allow create: if hasStartupAccess() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && (
          resource.data.recipientUid == request.auth.uid ||
          resource.data.senderUid == request.auth.uid
        )
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.recipientUid == resource.data.recipientUid
      );
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow get: if hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if hasStartupAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if isAdmin() || (
        hasStartupAccess() && resource.data.ownerUid == request.auth.uid
      );
    }
    
    match /deals/{dealId} {
      allow get: if hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if hasStartupAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
      );
      match /notes/{noteId} { allow read, write: if isAdmin() || (
          hasStartupAccess()
          && exists(/databases/$(database)/documents/deals/$(dealId))
          && get(/databases/$(database)/documents/deals/$(dealId)).data.ownerUid == request.auth.uid
        ); }
      match /activities/{activityId} { allow read, write: if isAdmin() || (
          hasStartupAccess()
          && exists(/databases/$(database)/documents/deals/$(dealId))
          && get(/databases/$(database)/documents/deals/$(dealId)).data.ownerUid == request.auth.uid
        ); }
    }

    match /invoices/{invoiceId} {
      allow get: if true; 
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if hasStartupAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (hasStartupAccess() && resource.data.ownerUid == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow get: if hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid;
      allow list: if isHardcodedAdmin() || (hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if hasStartupAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
      );
      match /activities/{activityId} { allow read, write: if isAdmin() || (
          hasStartupAccess()
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerUid == request.auth.uid
        ); }
    }

    match /connections/{connectionId} {
      allow get: if isHardcodedAdmin()
        || (hasStartupAccess() && (
          (connectionId.matches('^investor_' + request.auth.uid + '_.*$')
            && (!exists(/databases/$(database)/documents/connections/$(connectionId))
              || resource.data.get('initiatorUid', '') == request.auth.uid))
          || resource.data.get('initiatorUid', '') == request.auth.uid
          || resource.data.get('recipientUid', '') == request.auth.uid
        ));

      allow list: if isHardcodedAdmin()
        || (hasStartupAccess() && (
          resource.data.get('initiatorUid', '') == request.auth.uid
          || resource.data.get('recipientUid', '') == request.auth.uid
        ));

      allow create: if hasStartupAccess()
        && request.resource.data.get('initiatorUid', '') == request.auth.uid
        && request.resource.data.get('recipientUid', '') is string
        && request.resource.data.get('recipientUid', '') != ''
        && request.resource.data.get('recipientUid', '') != request.auth.uid
        && request.resource.data.get('type', '') in [
          'investor', 'cofounder', 'mentor', 'founder', 'service'
        ]
        && request.resource.data.get('status', '') == 'pending'
        && (
          request.resource.data.get('type', '') != 'investor'
          || connectionId == 'investor_' + request.auth.uid + '_' +
            request.resource.data.get('recipientUid', '')
        )
        && request.resource.data.keys().hasOnly([
          'initiatorUid', 'recipientUid', 'type', 'status',
          'message', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'initiatorUid', 'recipientUid', 'type', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time;

      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.get('recipientUid', '') == request.auth.uid
        && resource.data.get('status', '') == 'pending'
        && request.resource.data.get('status', '') in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.get('updatedAt', null) == request.time
        && (
          request.resource.data.get('status', '') != 'accepted'
          || resource.data.get('type', '') != 'investor'
          || (
            existsAfter(
              /databases/$(database)/documents/dealRooms/$(
                'funding_' + resource.data.recipientUid + '_' +
                resource.data.initiatorUid
              )
            )
            && getAfter(
              /databases/$(database)/documents/dealRooms/$(
                'funding_' + resource.data.recipientUid + '_' +
                resource.data.initiatorUid
              )
            ).data.founderUid == resource.data.recipientUid
            && getAfter(
              /databases/$(database)/documents/dealRooms/$(
                'funding_' + resource.data.recipientUid + '_' +
                resource.data.initiatorUid
              )
            ).data.investorUid == resource.data.initiatorUid
            && getAfter(
              /databases/$(database)/documents/dealRooms/$(
                'funding_' + resource.data.recipientUid + '_' +
                resource.data.initiatorUid
              )
            ).data.startupId == resource.data.recipientUid
          )
        )
      );

      allow delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.get('initiatorUid', '') == request.auth.uid
        && resource.data.get('status', '') == 'pending'
      );
    }

    match /startups/{startupId} {
      allow get: if isAdmin()
        || resource.data.get('status', '') == 'active'
        || (
          hasStartupAccess()
          && resource.data.ownerUid == request.auth.uid
        );
      allow list: if isHardcodedAdmin() || resource.data.get('status', '') == 'active' || (hasStartupAccess() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if hasStartupAccess() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      match /views/{viewId} {
        allow read: if isAdmin() || (
          hasStartupAccess()
          && get(/databases/$(database)/documents/startups/$(startupId)).data.ownerUid == request.auth.uid
        );
        allow write: if false;
      }

      match /interests/{interestId} {
        allow read: if isAdmin() || (
          hasStartupAccess()
          && (
            request.auth.uid == interestId
            || get(/databases/$(database)/documents/startups/$(startupId)).data.ownerUid == request.auth.uid
          )
        );
        allow write: if false;
      }
    }
    
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if hasStartupAccess() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.authorUid == request.auth.uid
      );
    }

    match /communityPostLikes/{likeId} {
      allow read: if true;
      allow create: if hasStartupAccess()
        && request.resource.data.userUid == request.auth.uid;
      allow update: if false;
      allow delete: if hasStartupAccess()
        && resource.data.userUid == request.auth.uid;
    }

    match /communityComments/{commentId} {
      allow read: if true;
      allow create: if hasStartupAccess() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.authorUid == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow list: if hasStartupAccess() && resource.data.get('recipientUid', '') == request.auth.uid;
      allow get: if isAdmin() || (hasStartupAccess() && resource.data.recipientUid == request.auth.uid);
      allow create: if (
          hasStartupAccess() ||
          (
            isAdmin() &&
            request.resource.data.type == "moderation"
          )
        )
        && request.resource.data.keys().hasAll([
          "recipientUid", "actorUid", "type", "title",
          "message", "read", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "recipientUid", "actorUid", "type", "title",
          "message", "targetId", "targetType", "read", "createdAt"
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.type in [
          "like", "comment", "pitch", "connection", "system",
          "message", "cofounder_interest", "investor_interest",
          "rejection", "moderation", "venture_pitch"
        ]
        && (request.resource.data.type != "moderation" || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.get("targetId", "") is string
        && request.resource.data.get("targetType", "") is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (
        hasStartupAccess()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read is bool
      );
      allow delete: if isAdmin() || (
        hasStartupAccess()
        && resource.data.recipientUid == request.auth.uid
      );
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || (
        hasStartupAccess()
        && request.auth.uid in resource.data.get('participants', [])
      );

      allow create: if hasStartupAccess()
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastMessage'
        ])
        && request.resource.data.keys().hasAll([
          'participants', 'createdAt', 'updatedAt', 'lastMessage'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == '';

      allow update: if isAdmin() || (
        hasStartupAccess()
        && request.auth.uid in resource.data.get('participants', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.updatedAt == request.time
      );

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          hasStartupAccess()
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('participants', [])
        );

        allow create: if hasStartupAccess()
          && request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('participants', [])
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'timestamp'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'text', 'timestamp'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.timestamp == request.time;
      }
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    match /seoPages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
