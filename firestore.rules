
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'T2JnkPYdsoZGO8krUqcP3T5bvg62' ||
        request.auth.token.email == 'shahmubaruk05@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['admin', 'super_admin'])
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /savedStartups/{saveId} {
      allow read, delete: if isSignedIn() && (resource.data.investorUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.investorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.investorUid == request.auth.uid;
    }

    match /mentorshipSessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.mentorUid == request.auth.uid || resource.data.founderUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.mentorUid == request.auth.uid || request.resource.data.founderUid == request.auth.uid);
      allow update, delete: if isSignedIn() && (resource.data.mentorUid == request.auth.uid || isAdmin());
    }

    match /referrals/{referralId} {
      allow list: if isAdmin() || (isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid));
      allow get: if isAdmin() || (isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.referrerUid != request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.referredUid);
    }

    match /venturePitches/{pitchId} {
      allow list: if isAdmin() || (isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow get: if isAdmin() || (isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.senderUid == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    
    match /deals/{dealId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      match /notes/{noteId} { allow read, write: if isSignedIn(); }
      match /activities/{activityId} { allow read, write: if isSignedIn(); }
    }

    match /invoices/{invoiceId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /connections/{connectionId} {
      allow list: if isAdmin() || (isSignedIn() && (resource.data.initiatorUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow get: if isAdmin() || (isSignedIn() && (resource.data.initiatorUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.initiatorUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.initiatorUid == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /startups/{startupId} {
      allow get: if true;
      allow list: if isAdmin() || (resource.data.status == 'active') || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      match /views/{viewId} { allow read, create: if true; }
      match /interests/{interestId} { allow read: if true; allow create, update: if isSignedIn(); }
    }
    
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow list, get, update, delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create, update: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} { allow read, create: if isSignedIn(); }
    }
  }
}
