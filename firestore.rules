
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shahmubaruk05@gmail.com' ||
        request.auth.uid == 'T2JnkPYdsoZGO8krUqcP3T5bvg62' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['admin', 'super_admin'])
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus', 'bonusLimits', 'role', 'primaryRole', 'roles']) 
                      || isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.referrerUid != request.auth.uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.referredUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referredProfileCompleted'])) ||
        isAdmin()
      );
    }

    match /venturePitches/{pitchId} {
      allow list, get: if isAdmin() || (isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    
    match /deals/{dealId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /notes/{noteId} { allow read, write: if isSignedIn(); }
      match /activities/{activityId} { allow read, write: if isSignedIn(); }
    }

    match /invoices/{invoiceId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      match /activities/{activityId} { allow read, write: if isSignedIn(); }
    }

    match /connections/{connectionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (resource.data.initiatorUid == request.auth.uid || resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.initiatorUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.initiatorUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }
    
    match /communityPostLikes/{likeId} { 
      allow read: if true; 
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow delete: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
    }
    
    match /communityComments/{commentId} { 
      allow read: if true; 
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} { 
        allow read, create: if isSignedIn(); 
      }
    }

    match /startups/{startupId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid) || resource.data.status == 'active';
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
      match /views/{viewId} { allow read, create: if true; }
      match /interests/{interestId} { allow read: if true; allow create, update: if isSignedIn(); }
    }

    match /services/{serviceId} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.providerUid == request.auth.uid); 
    }
    
    match /seoPages/{pageId} { allow read: if true; allow write: if isAdmin(); }
    
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
    }
  }
}
