
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents an individual user profile (Founder, Mentor, or Investor) in TabStartup.",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "primaryRole": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "plan": { "type": "string", "enum": ["basic", "pro", "growth"], "default": "basic" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "past_due"], "default": "inactive" },
        "referralCode": { "type": "string" },
        "referralCount": { "type": "number", "default": 0 },
        "imageUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "headline": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "createdAt", "updatedAt"]
    },
    "MentorshipRequest": {
      "title": "MentorshipRequest",
      "type": "object",
      "description": "An inquiry for guidance sent from a founder to a mentor.",
      "properties": {
        "mentorUid": { "type": "string" },
        "founderUid": { "type": "string" },
        "startupId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "goals": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Declined", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mentorUid", "founderUid", "status", "createdAt"]
    },
    "SavedStartup": {
      "title": "SavedStartup",
      "type": "object",
      "description": "A startup bookmarked by an investor.",
      "properties": {
        "investorUid": { "type": "string" },
        "startupId": { "type": "string" },
        "startupName": { "type": "string" },
        "isWatchlist": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["investorUid", "startupId", "createdAt"]
    },
    "MentorshipSession": {
      "title": "MentorshipSession",
      "type": "object",
      "description": "A scheduled guidance session between a mentor and founder.",
      "properties": {
        "mentorUid": { "type": "string" },
        "founderUid": { "type": "string" },
        "founderName": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mentorUid", "founderUid", "status", "scheduledAt"]
    },
    "Referral": {
      "title": "Referral",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string" },
        "referredUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Startup": {
      "title": "Startup",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "VenturePitch": {
      "title": "VenturePitch",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "recipientUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Contact": {
      "title": "Contact",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "contactName": { "type": "string" }
      }
    },
    "Deal": {
      "title": "Deal",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "Invoice": {
      "title": "Invoice",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "invoiceNumber": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "User profile data." }
      },
      {
        "path": "/mentorshipRequests/{requestId}",
        "definition": { "entityName": "MentorshipRequest", "schema": { "$ref": "#/backend/entities/MentorshipRequest" }, "description": "Inquiries for mentorship." }
      },
      {
        "path": "/savedStartups/{saveId}",
        "definition": { "entityName": "SavedStartup", "schema": { "$ref": "#/backend/entities/SavedStartup" }, "description": "Startups saved by investors." }
      },
      {
        "path": "/mentorshipSessions/{sessionId}",
        "definition": { "entityName": "MentorshipSession", "schema": { "$ref": "#/backend/entities/MentorshipSession" }, "description": "Mentorship logs." }
      },
      {
        "path": "/referrals/{referralId}",
        "definition": { "entityName": "Referral", "schema": { "$ref": "#/backend/entities/Referral" }, "description": "Tracks referrals." }
      },
      {
        "path": "/startups/{startupId}",
        "definition": { "entityName": "Startup", "schema": { "$ref": "#/backend/entities/Startup" }, "description": "Venture listings." }
      },
      {
        "path": "/venturePitches/{pitchId}",
        "definition": { "entityName": "VenturePitch", "schema": { "$ref": "#/backend/entities/VenturePitch" }, "description": "Investment pitches." }
      }
    ]
  }
}
